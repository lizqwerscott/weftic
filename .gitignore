# Build output
/target

# Environment
.env
.env.*
!.env.example

# Local config (examples are tracked)
configs/*
!configs/config.example.toml
!configs/models.example.toml

# Local characters (only the default is tracked)
characters/*
!characters/default.md

# Agent local state (Command Code)
/.commandcode/

# Local runtime data (event store)
/data/
